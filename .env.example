# .env.example - optional overrides

# Optional DB path override
CS2_DB_PATH=cs2_prices.sqlite

# Optional secret key for Flask sessions and secret encryption key derivation
FLASK_SECRET_KEY=change-me

# Bind address / port for Flask app (set host to 0.0.0.0 for LAN access)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional legacy fallback for Telegram
TELEGRAM_BOT_TOKEN=123456:ABCdefGHI_jklMNOpQrst
TELEGRAM_CHAT_ID=123456789
