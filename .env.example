# .env.example — copy to .env and fill values

# Telegram bot token (from BotFather)
TELEGRAM_BOT_TOKEN=123456:ABCdefGHI_jklMNOpQrst
# Chat id to send notifications to (user ID or group chat ID)
TELEGRAM_CHAT_ID=123456789

# Optional: change DB path (default: cs2_prices.sqlite)
#DB_PATH=cs2_prices.sqlite

# Notes:
# - Keep this file outside version control. Add .env to .gitignore (already present).
# - If TELEGRAM_* are missing, app will print messages to console instead of sending Telegram.
